# Environment Configuration Template
# Copy to .env and customize for your setup

# Project paths (absolute)
PROJECT_ROOT=e:\Brain
DATA_DIR=e:\Brain\Dataset
PROCESSED_DIR=e:\Brain\data\processed
MODEL_DIR=e:\Brain\models
RUNS_DIR=e:\Brain\runs

# Hardware
CUDA_VISIBLE_DEVICES=0
# Set to limit GPU memory (optional, in MB)
# PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# Training
DEFAULT_SEED=42
NUM_WORKERS=4

# API
API_HOST=0.0.0.0
API_PORT=8000
MODEL_PATH=models/best_model.onnx
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes

# Logging
LOG_LEVEL=INFO
TENSORBOARD_PORT=6006

# Optional: Kaggle (for dataset download)
# KAGGLE_USERNAME=your_username
# KAGGLE_KEY=your_api_key
